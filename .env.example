# Réglages de la version Docker (docker compose). Copie ce fichier en « .env » dans le même dossier.
# .env contient des secrets : il n'est pas versionné (voir .gitignore), garde-le pour toi.

# Premier compte administrateur, créé au premier démarrage (base sans aucun compte).
# Si ADMIN_PASSWORD est vide, un mot de passe provisoire est généré et affiché dans les journaux :
#   docker compose logs app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Tunnel Cloudflare. Vide : adresse temporaire https://xxx.trycloudflare.com (change à chaque
# redémarrage, affichée dans l'outil → Mon compte). Avec le jeton d'un tunnel nommé : adresse fixe
# sur ton domaine, par ex. revision.stratbook.dpdns.org (Public Hostname → HTTP app:8765, voir le README).
CLOUDFLARE_TUNNEL_TOKEN=

# Optionnel : adresse publique à afficher si elle n'est pas détectée automatiquement.
PUBLIC_URL=

# Port local de l'outil sur ce PC (http://127.0.0.1:8765).
DL_PORT=8765

# Durée de connexion avant de devoir ressaisir son mot de passe (jours).
DL_SESSION_DAYS=30
